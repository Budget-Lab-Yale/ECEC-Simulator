{
  // LaTeX Workshop, for state_data/docs/SUMMARY_method.tex.
  // Positron and VS Code both read this file.

  // Build with latexmk on save. latexmk runs pdflatex as many times as the
  // cross-references need, so hyperref and \ref settle in one command.
  "latex-workshop.latex.recipe.default": "first",
  "latex-workshop.latex.autoBuild.run": "onSave",

  // Artefacts stay beside the .tex. .gitignore covers them.
  "latex-workshop.latex.outDir": "%DIR%",

  // Do NOT auto-clean: the .log is how Overfull and Underfull boxes get read
  // after a build. Leave it on disk.
  "latex-workshop.latex.autoClean.run": "never",

  // Show box warnings in the Problems panel, so a bad line break is visible
  // without opening the log.
  "latex-workshop.message.badbox.show": true,

  // PDF opens in a side tab. Ctrl+Alt+J goes source to PDF; Ctrl+click in the
  // PDF goes back to the source line.
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.synctex.afterBuild.enabled": true,

  // The memo wraps at 78 columns by hand. Show the margin, do not enforce it.
  "[latex]": {
    "editor.rulers": [78],
    "editor.wordWrap": "off",
    "files.trimTrailingWhitespace": true
  }
}
