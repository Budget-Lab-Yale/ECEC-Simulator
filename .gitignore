# Files too large for git; cluster only.
state_data/raw/local/

# LaTeX build artefacts. latexmk and the LaTeX Workshop extension write these
# beside the .tex on every save. Patterns are global: nothing tracked matches
# them today, and any future .tex is covered too.
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.lof
*.log
*.lot
*.out
*.synctex.gz
*.synctex(busy)
*.toc

# Python bytecode
__pycache__/

# Anna's state documentation -- in-progress memo, drafts, source register kept
# local; current memo PDF (methodology-<date>.pdf) and docs/archive/ committed
state_data/docs/*
!state_data/docs/archive/
!state_data/docs/methodology-*.pdf

# Editor settings (memo LaTeX) -- local only
.vscode/
